{
  "name": "cortico-world-mosey",
  "version": "1.3.0",
  "type": "module",
  "description": "摸鱼（Mosey）：让 Coopanion 的桌宠自己去抖音和 B站逛一圈。关注流、周报、本地书库；视频、动态、专栏都能看能评；按额度点赞、评论、关注、发动态、私信；默认人审，三把工具、少 token。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "mosey",
    "douyin",
    "bilibili",
    "desktop-pet",
    "ai-companion",
    "playwright",
    "automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "lutsing <1940008084@qq.com> (https://github.com/liqin1018)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqin1018/cortico-world-mosey.git"
  },
  "homepage": "https://github.com/liqin1018/cortico-world-mosey#readme",
  "bugs": {
    "url": "https://github.com/liqin1018/cortico-world-mosey/issues"
  },
  "main": "./src/index.js",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "摸鱼",
    "describe": "describe.json",
    "webUiClient": "webui/client.js",
    "webUiStyle": "webui/style.css",
    "icon": "assets/icon.png",
    "screenshots": [
      "docs/panel-preview.png",
      "docs/life-section.png",
      "docs/detail-sheet.png",
      "docs/comments-sheet.png"
    ],
    "tags": [
      "video",
      "browser",
      "internet",
      "unofficial-api",
      "experimental",
      "companion",
      "external-setup",
      "injection-risk"
    ],
    "locales": {
      "zh": {
        "displayName": "摸鱼",
        "description": "让她自己去抖音/B站逛：刷候选、看关注流、看视频/动态/专栏、点赞、评论、回复楼中楼、关注、发动态、私信；还带周报和本地书库。公开动作有硬额度，默认先出草稿等你批准；三把工具，token 花得少。"
      },
      "en": {
        "displayName": "Mosey",
        "description": "Let her browse Douyin and Bilibili: feeds, following updates, videos, dynamics and articles; like, comment, reply in threads, follow, post, DM. Plus weekly recap and a local book library. Hard caps and owner approval by default; only three tools."
      }
    }
  },
  "files": [
    "src",
    "webui",
    "assets",
    "docs",
    "README.md",
    "DESIGN.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "scripts": {
    "describe": "node scripts/build-describe.mjs",
    "check": "node scripts/smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "deploy:local": "node scripts/deploy-local.mjs"
  }
}
